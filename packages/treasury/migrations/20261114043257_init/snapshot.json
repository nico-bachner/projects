    },
    {
      "table": "expenses",
      "name": "expenses_status",
      "value": "status IN ('submitted', 'changes_requested', 'approved', 'rejected', 'signed_off', 'submitted_to_sus', 'reimbursed')",
      "entityType": "checks"
    },
    {
